<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
  <TargetFramework>net8.0</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings>
  <Nullable>enable</Nullable>
  <NoWarn>$(NoWarn);SYSLIB00</NoWarn>
  <BaseOutputPath>$(MSBuildThisFileDirectory)..\build\</BaseOutputPath>
  <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
</PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="bin\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SilkroadSecurityAPI">
      <HintPath>..\lib\SilkroadSecurityAPI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    Copy the repo-root filters/ folder into the build output.
    - First build: everything is copied.
    - Later builds: files that already exist in the destination are NOT overwritten,
      so user edits in build/Debug/filters/ survive.
    - New files added in source are copied (destination doesn't exist yet).
  -->
  <Target Name="CopyFiltersToOutput" AfterTargets="Build">
    <ItemGroup>
      <FilterSourceFiles Include="$(MSBuildThisFileDirectory)filters\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FilterSourceFiles)" DestinationFiles="@(FilterSourceFiles->'$(OutDir)filters\%(RecursiveDir)%(Filename)%(Extension)')" Condition="!Exists('$(OutDir)filters\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>