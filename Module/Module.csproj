<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
  <TargetFramework>net10.0</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings>
  <Nullable>enable</Nullable>
  <NoWarn>$(NoWarn);SYSLIB00</NoWarn>
  <BaseOutputPath>$(MSBuildThisFileDirectory)..\build\</BaseOutputPath>
  <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

  <!-- NEW: GC tuning for high-throughput server workloads -->
  <ServerGarbageCollection>true</ServerGarbageCollection>
  <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  <TieredPGO>true</TieredPGO>
</PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <Compile Remove="filters\**" />
    <EmbeddedResource Remove="bin\**" />
    <EmbeddedResource Remove="filters\**" />
    <None Remove="bin\**" />
    <None Remove="filters\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SilkroadSecurityAPI\SilkroadSecurityAPI.csproj" />
  </ItemGroup>

  <!--
    Copy the repo-root filters/ folder into the build output.
    - First build: everything is copied.
    - Later builds: files that already exist in the destination are NOT overwritten,
      so user edits in build/Debug/filters/ survive.
    - New files added in source are copied (destination doesn't exist yet), unless
      the output has a managed packet catalog. That catalog owns its renamed paths;
      copying stale source paths back would register duplicate opcode handlers.
  -->
  <Target Name="CopyFiltersToOutput" AfterTargets="Build" Condition="!Exists('$(OutDir)filters\PACKETS.md')">
    <ItemGroup>
      <FilterSourceFiles Include="$(MSBuildThisFileDirectory)filters\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FilterSourceFiles)" DestinationFiles="@(FilterSourceFiles->'$(OutDir)filters\%(RecursiveDir)%(Filename)%(Extension)')" Condition="!Exists('$(OutDir)filters\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
